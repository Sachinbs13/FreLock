PORT=5000
NODE_ENV=development

# MongoDB Atlas — Atlas → Connect → Drivers. NEVER commit real credentials.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/frelock?retryWrites=true&w=majority

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required when NODE_ENV=production.
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated list of allowed browser origins. Leave empty in development
# (the Vite proxy makes requests same-origin).
CORS_ORIGIN=

# Seed the demo accounts on first start when the users collection is empty.
SEED_DEMO_USERS=true
